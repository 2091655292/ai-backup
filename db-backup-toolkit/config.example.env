# db-backup-toolkit configuration
# Copy to config.env (or export these as environment variables / GitHub secrets).
# Every value can be supplied as an environment variable.

# --- Which database ---------------------------------------------------------
# postgres | mysql | mariadb | mongodb | sqlite | redis | mssql | oracle | custom
DB_TYPE=postgres

DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=backup
DB_PASSWORD=change-me
DB_NAME=myapp

# Alternative to host/port/user/name for a single connection URL.
# DB_URL=postgresql://user:pass@host:5432/myapp
# DB_ALL=true

# SQLite only
# DB_FILE=/var/lib/app/app.db

# Custom dumper: any command that writes files into $RAW_DIR
# DB_DUMP_COMMAND=echo "..." > "$RAW_DIR/dump.txt"

# --- Where to store the backup ---------------------------------------------
# Any combination of: local,s3,webdav,git
BACKUP_TARGETS=s3,webdav,git

# Encryption (strongly recommended). Set one of the two:
# BACKUP_PASSPHRASE=super-secret-passphrase
# BACKUP_AGE_RECIPIENT=age1xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

COMPRESS_FORMAT=tar.gz
# Delete backups older than N days on every target (0 = keep forever).
RETENTION_DAYS=30

# --- Local target -----------------------------------------------------------
LOCAL_PATH=./backups

# --- S3 / S3-compatible (R2, MinIO, Wasabi, Backblaze) ----------------------
S3_BUCKET=my-backups
S3_PREFIX=db-backups
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...

# --- WebDAV (Nextcloud, ownCloud, Synology, ...) ----------------------------
WEBDAV_URL=https://cloud.example.com/remote.php/dav/files/user/backups
WEBDAV_USER=user
WEBDAV_PASSWORD=...
WEBDAV_PATH=db-backups
WEBDAV_VENDOR=nextcloud

# --- Private Git repository -------------------------------------------------
# A separate private repository is recommended. The token needs write access.
BACKUP_REPO=owner/private-backups
BACKUP_REPO_TOKEN=ghp_...
BACKUP_BRANCH=db-backups
GIT_PREFIX=backups
# Force-push a single commit so large dumps do not bloat the repository history.
GIT_SQUASH=true
# Full remote URL override (self-hosted Git, SSH, or testing). When set,
# BACKUP_REPO and BACKUP_REPO_TOKEN are not required.
# GIT_REMOTE_URL=git@github.com:owner/private-backups.git
